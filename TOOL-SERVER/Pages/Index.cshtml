@page
@model IndexModel
@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "VideoMaker — Biến ý tưởng thành video hoàn chỉnh";
    ViewData["Description"] = "VideoMaker giúp bạn lên ý tưởng, chuẩn bị kịch bản, tạo từng cảnh và hoàn thiện video trong một workspace dễ kiểm soát.";
}

<svg class="icon-sprite" aria-hidden="true">
    <symbol id="icon-arrow-right" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></symbol>
    <symbol id="icon-arrow-up-right" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10" /></symbol>
    <symbol id="icon-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></symbol>
    <symbol id="icon-chevron-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></symbol>
    <symbol id="icon-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></symbol>
    <symbol id="icon-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18" /></symbol>
    <symbol id="icon-play" viewBox="0 0 24 24"><path d="m8 5 11 7-11 7V5Z" /></symbol>
    <symbol id="icon-download" viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5M4 21h16" /></symbol>
    <symbol id="icon-sparkles" viewBox="0 0 24 24"><path d="m12 3 1.4 4.1L17.5 8.5l-4.1 1.4L12 14l-1.4-4.1-4.1-1.4 4.1-1.4L12 3Z" /><path d="m19 14 .8 2.2L22 17l-2.2.8L19 20l-.8-2.2L16 17l2.2-.8L19 14Z" /></symbol>
    <symbol id="icon-pen" viewBox="0 0 24 24"><path d="m15 5 4 4M5 19l2-5L17 4a2.1 2.1 0 0 1 3 3L10 17l-5 2Z" /><path d="M12 20H4" /></symbol>
    <symbol id="icon-image" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-5-5L5 21" /></symbol>
    <symbol id="icon-film" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 4v16M17 4v16M3 9h4m10 0h4M3 15h4m10 0h4" /></symbol>
    <symbol id="icon-volume" viewBox="0 0 24 24"><path d="M11 5 6 9H3v6h3l5 4V5ZM15 9a4 4 0 0 1 0 6M18 6a8 8 0 0 1 0 12" /></symbol>
    <symbol id="icon-sliders" viewBox="0 0 24 24"><path d="M4 21v-7m0-4V3m8 18v-9m0-4V3m8 18v-5m0-4V3M1 14h6m2-6h6m2 8h6" /></symbol>
    <symbol id="icon-folder" viewBox="0 0 24 24"><path d="M3 6a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6Z" /></symbol>
    <symbol id="icon-shopping" viewBox="0 0 24 24"><path d="M6 8h12l1 13H5L6 8Z" /><path d="M9 9V6a3 3 0 0 1 6 0v3" /></symbol>
    <symbol id="icon-phone" viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="20" rx="2" /><path d="M10 18h4" /></symbol>
    <symbol id="icon-book" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V4H6.5A2.5 2.5 0 0 0 4 6.5v13Z" /><path d="M4 19.5V6.5M8 8h8" /></symbol>
    <symbol id="icon-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></symbol>
    <symbol id="icon-shield" viewBox="0 0 24 24"><path d="M12 22c5-2 8-5 8-10V5l-8-3-8 3v7c0 5 3 8 8 10Z" /><path d="m9 12 2 2 4-4" /></symbol>
</svg>

<header class="site-header" data-site-header>
    <div class="container site-header__inner">
        <a class="brand" href="/" aria-label="VideoMaker — Trang chủ">
            <span class="brand__mark" aria-hidden="true">V</span>
            <span class="brand__text"><strong>VideoMaker</strong><small>AI Video Studio</small></span>
        </a>

        <button class="mobile-menu-button" type="button" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle>
            <span class="sr-only">Mở menu</span>
            <svg class="menu-open-icon"><use href="#icon-menu"></use></svg>
            <svg class="menu-close-icon"><use href="#icon-close"></use></svg>
        </button>

        <nav class="site-nav" id="primary-navigation" aria-label="Điều hướng chính" data-site-nav>
            <a class="nav-link" href="#use-cases">Dành cho ai</a>
            <a class="nav-link" href="#how-it-works">Cách hoạt động</a>
            <a class="nav-link" href="#features">Tính năng</a>
            <a class="nav-link" href="#experience">Trải nghiệm</a>
            <a class="nav-link" href="#faq">Câu hỏi</a>
            <a class="nav-download-mobile" href="/api/launcher-distribution/setup/latest/download?channel=Stable&amp;platform=win-x64"><svg><use href="#icon-download"></use></svg>Tải cho Windows</a>
        </nav>

        <a class="header-cta" href="/api/launcher-distribution/setup/latest/download?channel=Stable&amp;platform=win-x64">
            <svg><use href="#icon-download"></use></svg>
            <span>Tải cho Windows</span>
        </a>
    </div>
</header>

<main id="main-content">
    <section class="hero section" id="top">
        <div class="hero-glow hero-glow--one" aria-hidden="true"></div>
        <div class="hero-glow hero-glow--two" aria-hidden="true"></div>
        <div class="container hero__grid">
            <div class="hero__copy" data-reveal>
                <div class="eyebrow eyebrow--pill"><svg><use href="#icon-sparkles"></use></svg>Studio tạo video AI trên Windows</div>
                <h1 class="display">Biến một ý tưởng<br />thành <em>cả video.</em></h1>
                <p class="hero__lead">Bạn kể câu chuyện muốn làm. VideoMaker giúp chuẩn bị kịch bản, nhân vật và từng cảnh để bạn duyệt rồi xuất bản theo cách của mình.</p>
                <div class="hero__actions">
                    <a class="button button--primary" href="/api/launcher-distribution/setup/latest/download?channel=Stable&amp;platform=win-x64"><svg><use href="#icon-download"></use></svg><span>Tải VideoMaker</span></a>
                    <a class="button button--secondary" href="#how-it-works"><span>Xem cách tạo video</span><svg><use href="#icon-arrow-right"></use></svg></a>
                </div>
                <ul class="hero__proof" aria-label="Lợi ích nổi bật">
                    <li><svg><use href="#icon-check"></use></svg>Kịch bản rõ ràng</li>
                    <li><svg><use href="#icon-check"></use></svg>Nhân vật nhất quán</li>
                    <li><svg><use href="#icon-check"></use></svg>Duyệt từng cảnh trước khi xuất</li>
                </ul>
            </div>

            <div class="hero-product" data-reveal data-reveal-delay="1">
                <figure class="landing-photo hero-photo photo--editor">
                    <img src="~/images/landing/hero-video-creator.jpg" asp-append-version="true" width="1600" height="1067" alt="Nhà sáng tạo biên tập các cảnh video tại bàn làm việc" fetchpriority="high" decoding="async" />
                </figure>
            </div>
        </div>
        <div class="container outcome-strip" data-reveal>
            <span>Bắt đầu từ một chủ đề</span><i></i><span>Phát triển thành từng cảnh</span><i></i><span>Hoàn thiện trong một workspace</span>
        </div>
    </section>

    <section class="section use-cases-section" id="use-cases">
        <div class="container">
            <header class="section-heading" data-reveal><div><span class="eyebrow">Dành cho công việc của bạn</span><h2 class="section-title">Một studio cho nhiều<br />cách kể chuyện.</h2></div><p>Từ một video bán hàng ngắn đến chuỗi nội dung dài hơi, bạn luôn bắt đầu bằng điều mình muốn truyền tải.</p></header>
            <div class="use-case-grid">
                <article class="use-case-card use-case-card--commerce" data-reveal><div class="use-case-icon"><svg><use href="#icon-shopping"></use></svg></div><span class="use-case-number">01</span><h3>Bán hàng &amp; quảng bá</h3><p>Biến thông tin sản phẩm thành câu chuyện dễ xem, có mở đầu, điểm nhấn và lời kêu gọi rõ ràng.</p><figure class="portrait-scene landing-photo photo--camera"><img src="~/images/landing/marketing-creator.jpg" asp-append-version="true" width="1500" height="1000" alt="Người làm nội dung chuẩn bị máy quay cho một video quảng bá" loading="lazy" decoding="async" /></figure></article>
                <article class="use-case-card use-case-card--social" data-reveal data-reveal-delay="1"><div class="use-case-icon"><svg><use href="#icon-phone"></use></svg></div><span class="use-case-number">02</span><h3>Shorts, Reels &amp; TikTok</h3><p>Lên nội dung theo cảnh ngắn, dễ duyệt và phù hợp với nhịp xem trên thiết bị di động.</p><figure class="portrait-scene landing-photo photo--mobile"><img src="~/images/landing/mobile-video.jpg" asp-append-version="true" width="1500" height="1000" alt="Người dùng xem nội dung video dọc trên điện thoại" loading="lazy" decoding="async" /></figure></article>
                <article class="use-case-card use-case-card--story" data-reveal data-reveal-delay="2"><div class="use-case-icon"><svg><use href="#icon-book"></use></svg></div><span class="use-case-number">03</span><h3>Kể chuyện &amp; giáo dục</h3><p>Giữ nhân vật, bối cảnh và mạch nội dung xuyên suốt nhiều cảnh trong cùng một project.</p><figure class="portrait-scene landing-photo photo--storyboard"><img src="~/images/landing/idea-planning.jpg" asp-append-version="true" width="1500" height="1000" alt="Các khung storyboard được phác thảo để xây dựng mạch câu chuyện" loading="lazy" decoding="async" /></figure></article>
                <article class="use-case-card use-case-card--team" data-reveal data-reveal-delay="3"><div class="use-case-icon"><svg><use href="#icon-users"></use></svg></div><span class="use-case-number">04</span><h3>Đội ngũ nội dung</h3><p>Thống nhất cách làm việc, duyệt kết quả theo từng bước và giữ mọi phiên bản trong đúng dự án.</p><figure class="portrait-scene landing-photo photo--production"><img src="~/images/landing/production-crew.jpg" asp-append-version="true" width="1500" height="1000" alt="Máy quay và ê-kíp trong một buổi sản xuất nội dung" loading="lazy" decoding="async" /></figure></article>
            </div>
        </div>
    </section>

    <section class="section how-section" id="how-it-works">
        <div class="container">
            <header class="section-heading section-heading--center" data-reveal><div><span class="eyebrow">Đơn giản từ bước đầu tiên</span><h2 class="section-title">Từ ý tưởng đến video<br />chỉ trong ba bước.</h2></div><p>VideoMaker chuẩn bị phần phức tạp thành những bước trực quan để bạn luôn biết mình đang duyệt điều gì.</p></header>
            <ol class="how-grid">
                <li class="how-card" data-reveal><span class="how-number">01</span><figure class="how-visual landing-photo photo--workspace"><img src="~/images/landing/creative-workspace.jpg" asp-append-version="true" width="1500" height="1000" alt="Bàn sáng tạo với bút và bảng vẽ để phát triển ý tưởng" loading="lazy" decoding="async" /></figure><div class="how-copy"><small>BẠN BẮT ĐẦU</small><h3>Mô tả điều muốn kể</h3><p>Nhập chủ đề, thời lượng, phong cách và tỷ lệ video phù hợp với kênh của bạn.</p></div></li>
                <li class="how-card" data-reveal data-reveal-delay="1"><span class="how-number">02</span><figure class="how-visual landing-photo photo--storyboard"><img src="~/images/landing/idea-planning.jpg" asp-append-version="true" width="1500" height="1000" alt="Storyboard được sắp xếp thành từng khung nội dung" loading="lazy" decoding="async" /></figure><div class="how-copy"><small>VIDEOMAKER CHUẨN BỊ</small><h3>Duyệt câu chuyện từng cảnh</h3><p>Xem lại kịch bản, nhân vật, lời thoại và hình dung của từng cảnh trước khi tạo video.</p></div></li>
                <li class="how-card" data-reveal data-reveal-delay="2"><span class="how-number">03</span><figure class="how-visual landing-photo photo--review"><img src="~/images/landing/scene-review.jpg" asp-append-version="true" width="1500" height="1000" alt="Biên tập viên kiểm tra hình ảnh và nhịp dựng trước khi xuất video" loading="lazy" decoding="async" /></figure><div class="how-copy"><small>BẠN QUYẾT ĐỊNH</small><h3>Nghe, duyệt và xuất video</h3><p>Kiểm tra từng clip, duyệt âm thanh rồi ghép thành video hoàn chỉnh ngay trong workspace.</p></div></li>
            </ol>
        </div>
    </section>

    <section class="section features-section" id="features">
        <div class="container">
            <header class="section-heading" data-reveal><div><span class="eyebrow">Mọi thứ ở đúng một nơi</span><h2 class="section-title">Sáng tạo liền mạch.<br />Kiểm soát đến từng cảnh.</h2></div><p>Không còn phải tự ghép nhiều công cụ rời rạc để theo dõi nội dung, hình ảnh, clip và bản dựng.</p></header>
            <div class="feature-bento">
                <article class="feature-card feature-card--script" data-reveal><div class="feature-card__copy"><span class="feature-icon"><svg><use href="#icon-pen"></use></svg></span><small>KỊCH BẢN CÓ CẤU TRÚC</small><h3>Bắt đầu nhanh mà vẫn giữ giọng kể riêng.</h3><p>Nhận concept, kịch bản và danh sách cảnh rõ ràng; sau đó chỉnh lại nội dung trước khi đi tiếp.</p></div><figure class="feature-photo landing-photo photo--storyboard"><img src="~/images/landing/idea-planning.jpg" asp-append-version="true" width="1500" height="1000" alt="Các khung hình và ghi chú được phác thảo cho một câu chuyện" loading="lazy" decoding="async" /></figure></article>
                <article class="feature-card feature-card--character" data-reveal data-reveal-delay="1"><span class="feature-icon"><svg><use href="#icon-image"></use></svg></span><small>NHÂN VẬT NHẤT QUÁN</small><h3>Một diện mạo xuyên suốt câu chuyện.</h3><p>Tạo, thay thế và duyệt ảnh tham chiếu trước khi dùng nhân vật trong các cảnh.</p><figure class="feature-photo landing-photo photo--character"><img src="~/images/landing/character-design.jpg" asp-append-version="true" width="1500" height="1000" alt="Họa sĩ phác họa nhân vật trên bảng vẽ kỹ thuật số" loading="lazy" decoding="async" /></figure></article>
                <article class="feature-card feature-card--audio" data-reveal><span class="feature-icon"><svg><use href="#icon-volume"></use></svg></span><small>VIDEO CÓ ÂM THANH</small><h3>Hình ảnh và lời nói đi cùng nhau.</h3><p>Lời thoại, giọng đọc và không khí âm thanh được chuẩn bị theo đúng nội dung của cảnh.</p><figure class="feature-photo landing-photo photo--audio"><img src="~/images/landing/voice-audio.jpg" asp-append-version="true" width="1500" height="1000" alt="Micro thu âm trong không gian sản xuất nội dung" loading="lazy" decoding="async" /></figure></article>
                <article class="feature-card feature-card--review" data-reveal data-reveal-delay="1"><span class="feature-icon"><svg><use href="#icon-sliders"></use></svg></span><small>DUYỆT TỪNG CẢNH</small><h3>Chỉ đưa vào bản cuối những gì bạn đã chọn.</h3><p>Phát lại, nghe âm thanh và phê duyệt đúng phiên bản trước khi dựng.</p><figure class="feature-photo landing-photo photo--review"><img src="~/images/landing/scene-review.jpg" asp-append-version="true" width="1500" height="1000" alt="Người làm video xem lại từng cảnh trên bàn dựng" loading="lazy" decoding="async" /></figure></article>
                <article class="feature-card feature-card--workspace" data-reveal><div class="feature-card__copy"><span class="feature-icon"><svg><use href="#icon-folder"></use></svg></span><small>WORKSPACE THEO DỰ ÁN</small><h3>Mọi tài sản luôn ở đúng chỗ.</h3><p>Kịch bản, ảnh nhân vật, clip cảnh và video cuối được tổ chức theo từng project trên máy của bạn.</p></div><figure class="feature-photo landing-photo photo--editor"><img src="~/images/landing/hero-video-creator.jpg" asp-append-version="true" width="1600" height="1067" alt="Không gian làm việc dành cho biên tập và quản lý tài sản video" loading="lazy" decoding="async" /></figure></article>
            </div>
        </div>
    </section>

    <section class="section experience-section" id="experience">
        <div class="container">
            <article class="experience-panel" data-reveal>
                <header class="experience-head"><div><span class="eyebrow">Một quy trình trực quan</span><h2 class="section-title">Thấy toàn bộ câu chuyện.<br />Chạm vào từng chi tiết.</h2></div><p>Từ bản nháp đầu tiên đến cảnh cuối cùng, mỗi bước đều rõ ràng để bạn dễ xem lại và quyết định.</p></header>
                <ul class="experience-tabs" aria-label="Các bước trong workspace"><li class="is-active">Kế hoạch</li><li>Nhân vật</li><li>Storyboard</li><li>Duyệt video</li><li>Xuất bản</li></ul>
                <div class="experience-gallery">
                    <article class="experience-shot experience-shot--plan"><div class="shot-toolbar"><span></span><strong>Phác thảo câu chuyện</strong><small>Lên ý tưởng</small></div><figure class="experience-image landing-photo photo--workspace"><img src="~/images/landing/creative-workspace.jpg" asp-append-version="true" width="1500" height="1000" alt="Bàn làm việc dành cho việc ghi chú và phát triển ý tưởng hình ảnh" loading="lazy" decoding="async" /></figure><footer><strong>Chỉnh nội dung trước khi tạo</strong><span>01</span></footer></article>
                    <article class="experience-shot experience-shot--scene"><div class="shot-toolbar"><span></span><strong>Storyboard từng cảnh</strong><small>Sắp xếp mạch kể</small></div><figure class="experience-image landing-photo photo--storyboard"><img src="~/images/landing/idea-planning.jpg" asp-append-version="true" width="1500" height="1000" alt="Bản storyboard với nhiều khung cảnh và ghi chú" loading="lazy" decoding="async" /></figure><footer><strong>Nghe và duyệt từng cảnh</strong><span>02</span></footer></article>
                    <article class="experience-shot experience-shot--final"><div class="shot-toolbar"><span></span><strong>Video hoàn chỉnh</strong><small>Sẵn sàng xuất bản</small></div><figure class="experience-image landing-photo photo--camera"><img src="~/images/landing/marketing-creator.jpg" asp-append-version="true" width="1500" height="1000" alt="Máy quay chuyên nghiệp sẵn sàng ghi lại câu chuyện" loading="lazy" decoding="async" /></figure><footer><strong>Xuất đúng phiên bản bạn chọn</strong><span>03</span></footer></article>
                </div>
            </article>
        </div>
    </section>

    <section class="section control-section" id="control">
        <div class="container control-grid">
            <div class="control-copy" data-reveal><span class="eyebrow">Bạn luôn là người quyết định</span><h2 class="section-title">AI hỗ trợ.<br />Bạn giữ tay lái.</h2><p>VideoMaker không tự đưa một kết quả chưa kiểm tra vào bản cuối. Mỗi bước quan trọng đều chờ bạn xem lại và lựa chọn.</p><a class="text-link" href="#faq">Xem câu hỏi thường gặp <svg><use href="#icon-arrow-right"></use></svg></a></div>
            <div class="control-list" data-reveal data-reveal-delay="1"><article><span>01</span><div><h3>Chỉnh trước khi tạo</h3><p>Kịch bản, lời thoại và hình dung từng cảnh đều có thể xem lại.</p></div><svg><use href="#icon-pen"></use></svg></article><article><span>02</span><div><h3>Duyệt đúng phiên bản</h3><p>Một cảnh chỉ được đưa vào bản dựng khi bạn đã chọn nó.</p></div><svg><use href="#icon-check"></use></svg></article><article><span>03</span><div><h3>Giữ dự án trên máy</h3><p>Tài sản tải về và video hoàn chỉnh nằm trong workspace của bạn.</p></div><svg><use href="#icon-folder"></use></svg></article></div>
        </div>
    </section>

    <section class="section faq-section" id="faq">
        <div class="container faq-grid">
            <header data-reveal><span class="eyebrow">Câu hỏi thường gặp</span><h2 class="section-title">Trước khi bạn<br />bắt đầu.</h2><p>Những điều cơ bản để biết VideoMaker có phù hợp với cách làm nội dung của bạn hay không.</p></header>
            <div class="faq-list" data-faq-list data-reveal>
                <article class="faq-item"><h3><button type="button" aria-expanded="false"><span>Tôi có cần biết dựng video chuyên nghiệp không?</span><svg><use href="#icon-chevron-down"></use></svg></button></h3><div class="faq-answer"><p>Không cần biết sâu về phần mềm dựng phim. VideoMaker chia quy trình thành các bước rõ ràng để bạn chỉnh nội dung, duyệt từng cảnh và tạo bản cuối ngay trong ứng dụng.</p></div></article>
                <article class="faq-item"><h3><button type="button" aria-expanded="false"><span>Tôi có thể chỉnh lại từng cảnh không?</span><svg><use href="#icon-chevron-down"></use></svg></button></h3><div class="faq-answer"><p>Có. Bạn có thể sửa nội dung và hình dung của cảnh, tạo lại clip chưa phù hợp, sau đó chỉ duyệt phiên bản muốn dùng cho video cuối.</p></div></article>
                <article class="faq-item"><h3><button type="button" aria-expanded="false"><span>Video có lời thoại và âm thanh không?</span><svg><use href="#icon-chevron-down"></use></svg></button></h3><div class="faq-answer"><p>Có. Khi dự án sử dụng âm thanh, bạn có thể phát lại từng clip, kiểm tra lời thoại và nghe chất lượng trước khi phê duyệt.</p></div></article>
                <article class="faq-item"><h3><button type="button" aria-expanded="false"><span>VideoMaker hỗ trợ video dọc và ngang chứ?</span><svg><use href="#icon-chevron-down"></use></svg></button></h3><div class="faq-answer"><p>Có. Khi tạo dự án, bạn chọn tỷ lệ phù hợp với nội dung dọc cho mạng xã hội hoặc video ngang cho các định dạng trình chiếu thông thường.</p></div></article>
                <article class="faq-item"><h3><button type="button" aria-expanded="false"><span>Các tệp video được lưu ở đâu?</span><svg><use href="#icon-chevron-down"></use></svg></button></h3><div class="faq-answer"><p>Ảnh, clip cảnh và video hoàn chỉnh được tải về workspace của dự án trên máy tính để bạn tiếp tục quản lý và sử dụng.</p></div></article>
                <article class="faq-item"><h3><button type="button" aria-expanded="false"><span>Tôi cần máy tính như thế nào?</span><svg><use href="#icon-chevron-down"></use></svg></button></h3><div class="faq-answer"><p>VideoMaker chạy trên Windows. Thời gian kiểm tra và dựng video phụ thuộc cấu hình máy, dung lượng project và độ dài nội dung bạn đang làm.</p></div></article>
            </div>
        </div>
    </section>

