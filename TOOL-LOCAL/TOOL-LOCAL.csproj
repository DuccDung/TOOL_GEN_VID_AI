<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>TOOL_LOCAL</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <DesktopBuildNumber>1</DesktopBuildNumber>
    <AssemblyName>TOOL-LOCAL</AssemblyName>
    <Product>VideoMaker</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Sdcb.PaddleOCR" Version="3.3.1" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.Local" Version="3.3.1" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.LocalV5" Version="3.3.1" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="3.3.1.70" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
    <ProjectReference Include="..\TOOL-SHARED.Contracts\TOOL-SHARED.Contracts.csproj" />
    <ProjectReference Include="..\TOOL-DISTRIBUTION\TOOL-DISTRIBUTION.csproj" />
    <ProjectReference Include="..\TOOL-UPDATER\TOOL-UPDATER.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TOOL-VIETSUB-TRANSLATION-WORKER\TOOL-VIETSUB-TRANSLATION-WORKER.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DesktopBuildNumber</_Parameter1>
      <_Parameter2>$(DesktopBuildNumber)</_Parameter2>
    </AssemblyAttribute>
    <InternalsVisibleTo Include="TOOL-TESTS" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\third_party\bilibili\LICENSE" LogicalName="Bilibili.LICENSE" />
    <EmbeddedResource Include="..\third_party\bilibili\THIRD_PARTY_LICENSES.txt" LogicalName="Bilibili.THIRD_PARTY_LICENSES.txt" />
    <EmbeddedResource Include="..\third_party\bilibili\PROVENANCE.md" LogicalName="Bilibili.PROVENANCE.md" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.user.json" Condition="Exists('appsettings.user.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Vietsub\Voice\Workers\piper_worker.py" Link="workers\piper_worker.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="SystemSetup\piper-requirements.lock" Link="workers\piper-requirements.lock" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Vietsub\Voice\Workers\kokoro_worker.py" Link="workers\kokoro_worker.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="SystemSetup\kokoro-requirements.lock" Link="workers\kokoro-requirements.lock" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="SystemSetup\Fixtures\*.png" Link="setup-fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="LocalVoice\Workers\voice_consistency_worker.py" Link="workers\voice_consistency_worker.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="LocalVoice\Workers\install_voice_consistency.ps1" Link="workers\install_voice_consistency.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="LocalVoice\Workers\requirements.lock" Link="workers\requirements.lock" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <DashboardWebDirectory>$(MSBuildProjectDirectory)\Web</DashboardWebDirectory>
    <DashboardWebDist>$(DashboardWebDirectory)\dist</DashboardWebDist>
    <FfmpegBundleDirectory Condition="'$(FfmpegBundleDirectory)' == ''">$(MSBuildProjectDirectory)\..\third_party\ffmpeg\win-x64</FfmpegBundleDirectory>
    <OcrNoticeDirectory>$(MSBuildProjectDirectory)\..\third_party\ocr</OcrNoticeDirectory>
    <TranslationNoticeDirectory>$(MSBuildProjectDirectory)\..\third_party\translation</TranslationNoticeDirectory>
    <VoiceNoticeDirectory>$(MSBuildProjectDirectory)\..\third_party\voice</VoiceNoticeDirectory>
    <RequireMediaToolBundle Condition="'$(RequireMediaToolBundle)' == ''">false</RequireMediaToolBundle>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(FfmpegBundleDirectory)\ffmpeg.exe') And Exists('$(FfmpegBundleDirectory)\ffprobe.exe') And Exists('$(FfmpegBundleDirectory)\LICENSE.txt')">
    <Content Include="$(FfmpegBundleDirectory)\ffmpeg.exe" Link="tools\ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(FfmpegBundleDirectory)\ffprobe.exe" Link="tools\ffmpeg\ffprobe.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(FfmpegBundleDirectory)\LICENSE.txt" Link="tools\ffmpeg\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(FfmpegBundleDirectory)\PROVENANCE.md" Link="tools\ffmpeg\PROVENANCE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(FfmpegBundleDirectory)\PROVENANCE.md')" />
    <Content Include="$(FfmpegBundleDirectory)\checksums.sha256" Link="tools\ffmpeg\checksums.sha256" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(FfmpegBundleDirectory)\checksums.sha256')" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(OcrNoticeDirectory)\LICENSE-APACHE-2.0.txt') And Exists('$(OcrNoticeDirectory)\PROVENANCE.md') And Exists('$(OcrNoticeDirectory)\NUGET_HASHES.sha512')">
    <Content Include="$(OcrNoticeDirectory)\LICENSE-APACHE-2.0.txt" Link="third_party\ocr\LICENSE-APACHE-2.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(OcrNoticeDirectory)\PROVENANCE.md" Link="third_party\ocr\PROVENANCE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(OcrNoticeDirectory)\NUGET_HASHES.sha512" Link="third_party\ocr\NUGET_HASHES.sha512" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(TranslationNoticeDirectory)\PROVENANCE.md') And Exists('$(TranslationNoticeDirectory)\COMPONENT_MANIFEST.json') And Exists('$(TranslationNoticeDirectory)\checksums.sha256')">
    <Content Include="$(TranslationNoticeDirectory)\PROVENANCE.md" Link="third_party\translation\PROVENANCE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(TranslationNoticeDirectory)\COMPONENT_MANIFEST.json" Link="third_party\translation\COMPONENT_MANIFEST.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(TranslationNoticeDirectory)\checksums.sha256" Link="third_party\translation\checksums.sha256" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(TranslationNoticeDirectory)\NUGET_HASHES.sha512" Link="third_party\translation\NUGET_HASHES.sha512" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(TranslationNoticeDirectory)\LICENSE-LLAMASHARP-AND-LLAMA.CPP-MIT.txt" Link="third_party\translation\LICENSE-LLAMASHARP-AND-LLAMA.CPP-MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(OcrNoticeDirectory)\LICENSE-APACHE-2.0.txt" Link="third_party\translation\LICENSE-QWEN3-APACHE-2.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(VoiceNoticeDirectory)\PROVENANCE.md') And Exists('$(VoiceNoticeDirectory)\COMPONENT_MANIFEST.json') And Exists('$(VoiceNoticeDirectory)\checksums.sha256') And Exists('$(VoiceNoticeDirectory)\LICENSES.md')">
    <Content Include="$(VoiceNoticeDirectory)\PROVENANCE.md" Link="third_party\voice\PROVENANCE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(VoiceNoticeDirectory)\COMPONENT_MANIFEST.json" Link="third_party\voice\COMPONENT_MANIFEST.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(VoiceNoticeDirectory)\checksums.sha256" Link="third_party\voice\checksums.sha256" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(VoiceNoticeDirectory)\LICENSES.md" Link="third_party\voice\LICENSES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateOcrNotices" BeforeTargets="Publish">
    <Error Condition="!Exists('$(OcrNoticeDirectory)\LICENSE-APACHE-2.0.txt')" Text="OCR third-party license is missing: $(OcrNoticeDirectory)\LICENSE-APACHE-2.0.txt" />
    <Error Condition="!Exists('$(OcrNoticeDirectory)\PROVENANCE.md')" Text="OCR provenance is missing: $(OcrNoticeDirectory)\PROVENANCE.md" />
    <Error Condition="!Exists('$(OcrNoticeDirectory)\NUGET_HASHES.sha512')" Text="OCR NuGet hashes are missing: $(OcrNoticeDirectory)\NUGET_HASHES.sha512" />
  </Target>

  <Target Name="ValidateTranslationNotices" BeforeTargets="Publish">
    <Error Condition="!Exists('$(TranslationNoticeDirectory)\PROVENANCE.md')" Text="Translation provenance is missing: $(TranslationNoticeDirectory)\PROVENANCE.md" />
    <Error Condition="!Exists('$(TranslationNoticeDirectory)\COMPONENT_MANIFEST.json')" Text="Translation component manifest is missing: $(TranslationNoticeDirectory)\COMPONENT_MANIFEST.json" />
    <Error Condition="!Exists('$(TranslationNoticeDirectory)\checksums.sha256')" Text="Translation model checksum is missing: $(TranslationNoticeDirectory)\checksums.sha256" />
    <Error Condition="!Exists('$(TranslationNoticeDirectory)\NUGET_HASHES.sha512')" Text="Translation NuGet hashes are missing: $(TranslationNoticeDirectory)\NUGET_HASHES.sha512" />
    <Error Condition="!Exists('$(TranslationNoticeDirectory)\LICENSE-LLAMASHARP-AND-LLAMA.CPP-MIT.txt')" Text="Translation runtime license is missing: $(TranslationNoticeDirectory)\LICENSE-LLAMASHARP-AND-LLAMA.CPP-MIT.txt" />
    <Error Condition="!Exists('$(OcrNoticeDirectory)\LICENSE-APACHE-2.0.txt')" Text="Qwen3 Apache license is missing: $(OcrNoticeDirectory)\LICENSE-APACHE-2.0.txt" />
  </Target>

  <Target Name="ValidateVoiceNotices" BeforeTargets="Publish">
    <Error Condition="!Exists('$(VoiceNoticeDirectory)\PROVENANCE.md')" Text="Voice provenance is missing: $(VoiceNoticeDirectory)\PROVENANCE.md" />
    <Error Condition="!Exists('$(VoiceNoticeDirectory)\COMPONENT_MANIFEST.json')" Text="Voice component manifest is missing: $(VoiceNoticeDirectory)\COMPONENT_MANIFEST.json" />
    <Error Condition="!Exists('$(VoiceNoticeDirectory)\checksums.sha256')" Text="Voice component checksums are missing: $(VoiceNoticeDirectory)\checksums.sha256" />
    <Error Condition="!Exists('$(VoiceNoticeDirectory)\LICENSES.md')" Text="Voice license notice is missing: $(VoiceNoticeDirectory)\LICENSES.md" />
  </Target>

  <Target Name="ValidateMediaToolBundle" BeforeTargets="Publish" Condition="'$(RequireMediaToolBundle)' == 'true'">
    <Error Condition="!Exists('$(FfmpegBundleDirectory)\ffmpeg.exe')" Text="FFmpeg bundle is missing ffmpeg.exe: $(FfmpegBundleDirectory)" />
    <Error Condition="!Exists('$(FfmpegBundleDirectory)\ffprobe.exe')" Text="FFmpeg bundle is missing ffprobe.exe: $(FfmpegBundleDirectory)" />
    <Error Condition="!Exists('$(FfmpegBundleDirectory)\LICENSE.txt')" Text="FFmpeg bundle is missing LICENSE.txt: $(FfmpegBundleDirectory)" />
    <Error Condition="!Exists('$(FfmpegBundleDirectory)\PROVENANCE.md')" Text="FFmpeg bundle is missing PROVENANCE.md: $(FfmpegBundleDirectory)" />
    <Error Condition="!Exists('$(FfmpegBundleDirectory)\checksums.sha256')" Text="FFmpeg bundle is missing checksums.sha256: $(FfmpegBundleDirectory)" />
  </Target>

  <Target Name="BuildDashboardWeb" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec
      WorkingDirectory="$(DashboardWebDirectory)"
      Command="npm ci --no-audit --no-fund"
      Condition="!Exists('$(DashboardWebDirectory)\node_modules\react\package.json')" />
    <Exec WorkingDirectory="$(DashboardWebDirectory)" Command="npm run build" />
  </Target>

  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <Target Name="CopyDashboardWeb" AfterTargets="Build" DependsOnTargets="BuildDashboardWeb">
    <RemoveDir Directories="$(TargetDir)wwwroot\assets" />
    <ItemGroup>
      <DashboardWebAsset Include="$(DashboardWebDist)\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(DashboardWebAsset)"
      DestinationFiles="@(DashboardWebAsset->'$(TargetDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="IncludeDashboardInPublish" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="BuildDashboardWeb">
    <ItemGroup>
      <DashboardPublishFile Include="$(DashboardWebDist)\**\*" />
      <ResolvedFileToPublish Include="@(DashboardPublishFile)">
        <RelativePath>wwwroot\%(DashboardPublishFile.RecursiveDir)%(DashboardPublishFile.Filename)%(DashboardPublishFile.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- CopyFilesToPublishDirectory dependencies already copy assets before its BeforeTargets run.
       Clean before computing/copying files, so repeated publish cannot delete the freshly copied UI. -->
  <Target Name="CleanDashboardPublishAssets" BeforeTargets="ComputeFilesToPublish" Condition="'$(PublishDir)' != ''">
    <RemoveDir Directories="$(PublishDir)wwwroot\assets" />
  </Target>

  <Target Name="CopyUpdaterForBuild" AfterTargets="Build">
    <ItemGroup>
      <UpdaterBuildFile Include="$(MSBuildThisFileDirectory)..\TOOL-UPDATER\bin\$(Configuration)\net10.0-windows\win-x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterBuildFile)" DestinationFiles="@(UpdaterBuildFile->'$(TargetDir)_updater\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyTranslationWorkerForBuild" AfterTargets="Build">
    <ItemGroup>
      <TranslationWorkerBuildFile Include="$(MSBuildThisFileDirectory)..\TOOL-VIETSUB-TRANSLATION-WORKER\bin\$(Configuration)\net10.0-windows\win-x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(TranslationWorkerBuildFile)" DestinationFiles="@(TranslationWorkerBuildFile->'$(TargetDir)_translation_worker\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishUpdater" BeforeTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <UpdaterPublishDirectory>$(MSBuildProjectDirectory)\obj\$(Configuration)\updater-publish\</UpdaterPublishDirectory>
    </PropertyGroup>
    <MSBuild Projects="..\TOOL-UPDATER\TOOL-UPDATER.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;PublishDir=$(UpdaterPublishDirectory)" />
    <ItemGroup>
      <UpdaterPublishedFile Include="$(UpdaterPublishDirectory)VideoMaker.Updater.exe" />
      <ResolvedFileToPublish Include="@(UpdaterPublishedFile)">
        <RelativePath>_updater\VideoMaker.Updater.exe</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="PublishTranslationWorker" BeforeTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <TranslationWorkerPublishDirectory>$(MSBuildProjectDirectory)\obj\$(Configuration)\translation-worker-publish\</TranslationWorkerPublishDirectory>
    </PropertyGroup>
    <MSBuild Projects="..\TOOL-VIETSUB-TRANSLATION-WORKER\TOOL-VIETSUB-TRANSLATION-WORKER.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=false;PublishDir=$(TranslationWorkerPublishDirectory)" />
    <ItemGroup>
      <TranslationWorkerPublishedFile Include="$(TranslationWorkerPublishDirectory)**\*" />
      <ResolvedFileToPublish Include="@(TranslationWorkerPublishedFile)">
        <RelativePath>_translation_worker\%(TranslationWorkerPublishedFile.RecursiveDir)%(TranslationWorkerPublishedFile.Filename)%(TranslationWorkerPublishedFile.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
