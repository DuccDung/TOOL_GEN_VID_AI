<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Fixtures\SetupJobOwnerHost\**\*.cs" />
    <Compile Remove="Fixtures\DistributionResourcesA\**\*.cs;Fixtures\DistributionResourcesB\**\*.cs" />
    <ProjectReference Include="Fixtures\DistributionResourcesA\DistributionResourcesA.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Fixtures\DistributionResourcesB\DistributionResourcesB.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Fixtures\SetupJobOwnerHost\SetupJobOwnerHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TOOL-LOCAL\TOOL-LOCAL.csproj" />
    <ProjectReference Include="..\TOOL-SERVER\TOOL-SERVER.csproj" />
    <ProjectReference Include="..\TOOL-UPDATER\TOOL-UPDATER.csproj" />
    <ProjectReference Include="..\TOOL-SETUP\TOOL-SETUP.csproj" Aliases="SetupAssembly" />
    <ProjectReference Include="..\TOOL-DISTRIBUTION\TOOL-DISTRIBUTION.csproj" />
    <ProjectReference Include="..\TOOL-MODEL-PUBLISHER\TOOL-MODEL-PUBLISHER.csproj" />
    <ProjectReference Include="..\TOOL-VIETSUB-TRANSLATION-WORKER\TOOL-VIETSUB-TRANSLATION-WORKER.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- WindowsDesktop pruning assumes the installed host supplies Pkcs. Keep the server's
       patched servicing package in this test host so an older shared runtime cannot replace it. -->
  <Target Name="KeepPatchedPkcsInTestRuntime" DependsOnTargets="AddPrunePackageReferences" BeforeTargets="CollectPrunePackageReferences">
    <ItemGroup>
      <PrunePackageReference Remove="System.Security.Cryptography.Pkcs" />
    </ItemGroup>
  </Target>

  <Target Name="CopyDistributionResourceFixtures" AfterTargets="Build">
    <ItemGroup>
      <DistributionResourceFixture Include="$(MSBuildThisFileDirectory)Fixtures\DistributionResourcesA\bin\$(Configuration)\net10.0\DistributionResourcesA.exe;$(MSBuildThisFileDirectory)Fixtures\DistributionResourcesB\bin\$(Configuration)\net10.0\DistributionResourcesB.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(DistributionResourceFixture)" DestinationFolder="$(TargetDir)DistributionResources" SkipUnchangedFiles="true" />
  </Target>

  <!-- Setup and desktop both link BrandIdentity; keep the test-only alias on the resolved reference. -->
  <Target Name="ApplyVideoMakerSetupReferenceAlias" BeforeTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <ReferencePath Update="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'VideoMaker Setup'">
        <Aliases>SetupAssembly</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>

  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <Target Name="CopyTranslationWorkerForTests" AfterTargets="Build">
    <ItemGroup>
      <TranslationWorkerTestFile Include="$(MSBuildThisFileDirectory)..\TOOL-VIETSUB-TRANSLATION-WORKER\bin\$(Configuration)\net10.0-windows\win-x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(TranslationWorkerTestFile)" DestinationFiles="@(TranslationWorkerTestFile->'$(TargetDir)_translation_worker\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopySetupJobOwnerFixtureForTests" AfterTargets="Build">
    <ItemGroup>
      <SetupJobOwnerFixtureFile Include="$(MSBuildThisFileDirectory)Fixtures\SetupJobOwnerHost\bin\$(Configuration)\net10.0-windows\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SetupJobOwnerFixtureFile)" DestinationFolder="$(TargetDir)SetupJobOwnerHost" SkipUnchangedFiles="true" />
  </Target>

</Project>
